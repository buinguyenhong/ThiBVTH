<Window x:Class="ExamGenerator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Khảo Thí HIS - Bệnh Viện Đa Khoa Thiện Hạnh" 
        Height="860" Width="1340" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}" Loaded="Window_Loaded">
    <DockPanel>
        <!-- Header: Thiện Hạnh Branding & Live Status -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandNavy}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource BrandTeal}" Margin="0,0,16,0">
                        <TextBlock Text="TH" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BỆNH VIỆN ĐA KHOA THIỆN HẠNH" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Copyright © 2026 Bùi Nguyên Hồng - CNTT - Thiện Hạnh . All rights reserved." Foreground="{StaticResource BrandTealSoft}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <Border Background="{StaticResource BrandSlate}" CornerRadius="12" Padding="10,4" Margin="6,0">
                            <TextBlock x:Name="HeaderStatusText" Text="Hệ thống sẵn sàng" Foreground="{StaticResource BrandTealSoft}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="12" Padding="10,4">
                            <TextBlock Text=".NET 8 LTS · WPF" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeaderSubText" Text="Cơ sở dữ liệu: data/exam-generator.sqlite" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Text="Sẵn sàng." Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBlock Text="Phiên bản 2026.09 · Copyright © 2026 Bùi Nguyên Hồng - CNTT - Thiện Hạnh . All rights reserved." HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl x:Name="MainTabs" Margin="20,14,20,16" SelectionChanged="MainTabs_SelectionChanged">

            <!-- TAB 1: THỰC THI TẠO ĐỀ -->
            <TabItem Header="1. Thực thi tạo đề">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,12">
                        <!-- Card 1: Batch & Candidate Input -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Cấu hình Đợt thi &amp; Thêm Thí sinh" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Thiết lập thông tin khảo thí, chọn khoa và mẫu đề thi tương ứng." HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tên đợt thi" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="BatchNameTextBox" Text="TuyenDung_2026"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Ngày thi" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <DatePicker x:Name="ExamDatePicker" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0">
                                        <TextBlock Text="Họ tên thí sinh" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="CandidateNameTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0">
                                        <TextBlock Text="Số báo danh (SBD)" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="CandidateIdTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                        <TextBlock Text="Khoa / Phòng ứng tuyển" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="ExamDepartmentComboBox" SelectionChanged="ExamDepartmentChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Mẫu đề thi theo Khoa" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="ExamTemplateComboBox" SelectionChanged="ExamTemplateChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Kho Dược thi (chọn trong các kho của khoa)" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="ExamWarehouseComboBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0">
                                        <TextBlock Text="Thời gian làm bài (phút)" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="ExamDurationTextBox" Text="30" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Phân bổ User HIS" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <Border Background="{StaticResource BrandTealSoft}" CornerRadius="6" Padding="10,7" Height="34" Margin="0,4,0,8">
                                            <TextBlock x:Name="UserAllocationSummaryText" Text="Tự động cấp User riêng" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Score Preview Box -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource BrandCyanSoft}" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="MẪU ĐỀ" Foreground="{StaticResource BrandCyan}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock x:Name="ScoreSummaryText" Text="Chọn khoa và mẫu đề để xem chi tiết thang điểm." FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button Content="+ Thêm vào danh sách" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="AddCandidate_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Candidates List Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Danh sách Thí sinh chờ sinh đề" FontSize="16" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource BrandCyanSoft}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="CandidatesCountBadge" Text="0 thí sinh" Foreground="{StaticResource BrandCyan}" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Click="SelectAllCandidates_Click"/>
                                        <Button Content="Bỏ chọn tất cả" Style="{StaticResource SecondaryButton}" Click="ClearCandidateSelection_Click"/>
                                        <Button Content="Xóa đã chọn" Style="{StaticResource SecondaryButton}" Click="RemoveSelectedCandidates_Click"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="CandidatesGrid" Height="240">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding Name}" Width="1.6*"/>
                                        <DataGridTextColumn Header="Số báo danh" Binding="{Binding Id}" Width="0.9*"/>
                                        <DataGridTextColumn Header="Khoa / Phòng" Binding="{Binding Department}" Width="1.3*"/>
                                        <DataGridTextColumn Header="Kho Dược thi" Binding="{Binding WarehouseName}" Width="1.3*"/>
                                        <DataGridTextColumn Header="Mẫu đề thi" Binding="{Binding Template}" Width="1.8*"/>
                                        <DataGridTextColumn Header="Thời gian" Binding="{Binding DurationText}" Width="75"/>
                                        <DataGridTextColumn Header="Quy tắc cấp User HIS" Binding="{Binding UserStatus}" Width="1.4*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="GenerationStatusText" Text="Sẵn sàng chạy Preflight và sinh đề." Foreground="{StaticResource TextSecondary}" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="📦 Xuất gói đề ExamClient (.exam_pkg)" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="ExportExamClientPackages_Click"/>
                                        <Button Content="Sinh phần đã chọn (.zip)" Style="{StaticResource SecondaryButton}" Click="GenerateSelected_Click"/>
                                        <Button Content="⚡ Sinh Cả Đợt Thi (.zip)" Style="{StaticResource PrimaryButton}" Padding="20,10" FontSize="14" Click="GenerateAll_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: QUẢN LÝ MẪU ĐỀ -->
            <TabItem Header="2. Quản lý Mẫu đề">
                <Grid Margin="6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Templates List -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Danh sách Mẫu Đề Thi" FontSize="16" FontWeight="SemiBold"/>

                                <Grid Grid.Row="1" Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lọc theo khoa:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox Grid.Column="1" x:Name="TemplateDeptFilterComboBox" SelectionChanged="TemplateDeptFilterChanged"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <Button Content="+ Tạo mới" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="NewTemplate_Click" ToolTip="Tạo một mẫu đề thi mới"/>
                                    <Button Content="📋 Clone" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="CloneTemplate_Click" ToolTip="Nhân bản mẫu đề đang chọn và đổi tên/khoa"/>
                                    <Button Content="🗑️ Xóa" Style="{StaticResource DangerButton}" Padding="12,6" Click="DeleteTemplate_Click" ToolTip="Xóa mẫu đề đang chọn"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="TemplatesGrid" SelectionChanged="TemplateSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên mẫu đề" Binding="{Binding Name}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Khoa áp dụng" Binding="{Binding Department}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Số câu" Binding="{Binding QuestionCount}" Width="55"/>
                                    <DataGridTextColumn Header="Tổng điểm" Binding="{Binding TotalScore}" Width="70"/>
                                    <DataGridTextColumn Header="Hình thức nhận ca" Binding="{Binding Status}" Width="1.2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Right: Interactive Template Editor -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                        <DockPanel>
                            <!-- Editor Header -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TemplateEditorTitle" Text="Biên tập Mẫu Đề Thi" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandNavy}"/>
                                    <Border x:Name="TemplateEditorModeBadgeBorder" Background="{StaticResource BrandTealSoft}" BorderBrush="{StaticResource BrandTeal}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock x:Name="TemplateEditorModeBadge" Text="Đang chỉnh sửa" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="CancelEditTemplate_Click"/>
                                    <Button Content="💾 Lưu Mẫu Đề" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="SaveTemplate_Click"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Section 1: Template Basic Info -->
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left fields -->
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Tên mẫu đề thi (*):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EditorTemplateNameTextBox" Margin="0,0,0,10" Padding="8,5"/>

                                                <TextBlock Text="Khoa / Phòng áp dụng (*):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="EditorDepartmentComboBox" IsEditable="True" Margin="0,0,0,0" Padding="8,5"/>
                                            </StackPanel>

                                            <!-- Right fields -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Vị trí chuyên môn:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="EditorPositionComboBox" IsEditable="True" Margin="0,0,0,10" Padding="8,5"/>

                                                <TextBlock Text="Hình thức nhận ca (*):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="EditorReceptionModeComboBox" Margin="0,0,0,0" Padding="8,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Section 2: Questions and Scores Editor -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Danh sách Câu hỏi &amp; Phân bổ Thang điểm" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="QuestionsCountText" Text="(0 câu)" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <DataGrid x:Name="EditorQuestionsGrid" RowHeight="40" Height="270" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,0,0,10">
                                        <DataGrid.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Height" Value="28"/>
                                                <Setter Property="Margin" Value="2,1"/>
                                                <Setter Property="Padding" Value="6,2"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Binding="{Binding OrderIndex}" Width="45" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Mã hành động" Binding="{Binding ActionCode}" Width="190" IsReadOnly="True" Foreground="{StaticResource TextSecondary}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="4,0"/>
                                                        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="Tên câu hỏi trong đề thi" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Điểm (đ)" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Thao tác" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button Content="▲" Width="26" Height="26" Margin="1,0" Padding="0" Click="QuestionMoveUp_Click" Tag="{Binding}" ToolTip="Đẩy câu hỏi lên trên" Cursor="Hand"/>
                                                            <Button Content="▼" Width="26" Height="26" Margin="1,0" Padding="0" Click="QuestionMoveDown_Click" Tag="{Binding}" ToolTip="Đẩy câu hỏi xuống dưới" Cursor="Hand"/>
                                                            <Button Content="✕" Width="26" Height="26" Margin="2,0" Padding="0" Foreground="#DC2626" Background="#FEE2E2" BorderThickness="0" FontWeight="Bold" Click="QuestionRemove_Click" Tag="{Binding}" ToolTip="Xóa câu này khỏi đề" Cursor="Hand"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Section 3: Add Question from Action Library -->
                                    <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <TextBlock Text="Thêm câu hỏi từ Thư viện Nghiệp vụ HIS:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Content="⚙ Quản lý Thư viện / Thêm dạng mới..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="10,4" FontSize="12" Click="ManageActionLibrary_Click"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" x:Name="ActionLibraryComboBox" DisplayMemberPath="DisplayText" MaxDropDownHeight="320" Margin="0,0,8,0" Padding="8,6"/>
                                                <Button Grid.Column="1" Content="+ Thêm vào đề" Style="{StaticResource AccentButton}" Padding="14,6" Click="AddActionToTemplate_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Section 4: Live Total Score & Validation Summary -->
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="TotalScoreBadgeBorder" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                                                    <TextBlock x:Name="TotalScoreText" Text="Tổng điểm: 10.0 / 10.0 đ" FontWeight="Bold" FontSize="14" Foreground="#166534"/>
                                                </Border>
                                                <TextBlock x:Name="TotalScoreStatusText" Text="✓ Đạt chuẩn 10.0 điểm theo quy chế khảo thí BV Thiện Hạnh." Foreground="#166534" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="💾 Lưu Mẫu Đề" Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" Click="SaveTemplate_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: PHÂN QUYỀN DỊCH VỤ & KHO -->
            <TabItem Header="3. Phân quyền Dịch vụ &amp; Kho">
                <Grid Margin="6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Departments Master -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Khoa / Phòng Khảo thí" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox DockPanel.Dock="Top" x:Name="MappingSearchTextBox" TextChanged="MappingSearchChanged" Margin="0,0,0,8"/>
                            <ListBox x:Name="MappingDepartmentList" SelectionChanged="MappingDepartmentChanged" BorderBrush="{StaticResource BorderSubtle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Visibility="{Binding DisabledBadgeVisibility}">
                                                <TextBlock Text="Tạm ngưng" FontSize="11" Foreground="#DC2626" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right: Mapping Detail -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="MappingTitleText" Text="Cấu hình Kho thi &amp; Nhóm Dịch vụ" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
                                <TextBlock Text="Mỗi khoa có thể cấu hình một hoặc nhiều Kho Dược / Tủ trực phục vụ thi. Khi tạo đề thi, người dùng sẽ chọn 1 kho cụ thể cho thí sinh." Foreground="{StaticResource TextSecondary}" Margin="0,2,0,12"/>

                                <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                    <CheckBox x:Name="DepartmentActiveCheckBox" Click="DepartmentActive_Click" VerticalAlignment="Center" IsChecked="True">
                                        <TextBlock Text="Cho phép khoa này tham gia khảo thí (Bỏ chọn để Tạm ngưng thi thủ công mà không làm mất mapping &amp; đề thi)" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"/>
                                    </CheckBox>
                                </Border>

                                <TextBlock Text="Danh sách Kho Dược / Tủ trực thi trực thuộc khoa (Chọn ít nhất 1 kho)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WarehouseSearchTextBox" TextChanged="WarehouseSearchChanged" Height="32"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="SelectAllWarehouses_Click"/>
                                        <Button Content="Bỏ chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="ClearAllWarehouses_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="WarehouseMappingsList" Height="160" BorderBrush="{StaticResource BorderSubtle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Nhóm Dịch vụ Kỹ thuật / CLS được phép chỉ định" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServiceSearchTextBox" TextChanged="ServiceSearchChanged" Height="32"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="SelectAllServices_Click"/>
                                        <Button Content="Bỏ chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="ClearAllServices_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ServiceGroupsList" Height="240" BorderBrush="{StaticResource BorderSubtle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Danh sách Tài khoản User HIS thi (Chọn các user dùng cho khảo thí)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UserSearchTextBox" TextChanged="UserSearchChanged" Height="32"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="SelectAllUsers_Click"/>
                                        <Button Content="Bỏ chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="ClearAllUsers_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="DepartmentUsersList" Height="180" BorderBrush="{StaticResource BorderSubtle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4" VerticalAlignment="Center" Click="UserCheckBox_Click">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="UserCountStatusText" Text="Đã chọn: 0 user HIS" Foreground="#0D9488" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock x:Name="MappingStatusText" Text="Sẵn sàng lưu cấu hình." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Sao chép từ khoa khác" Style="{StaticResource SecondaryButton}" Click="CopyMapping_Click"/>
                                        <Button Content="Lưu Cấu Hình Khoa Này" Style="{StaticResource PrimaryButton}" Click="SaveMapping_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: CÀI ĐẶT & DANH MỤC HIS -->
            <TabItem Header="4. Cài đặt &amp; Danh mục HIS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,12">
                        <!-- Dashboard 6 Cards -->
                        <TextBlock Text="Tổng quan Danh mục Khảo thí (Local Snapshot)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Card 1 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Khoa / Phòng" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardDeptCount" Text="6" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                    <TextBlock Text="Snapshot đầy đủ" Foreground="{StaticResource SuccessGreen}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 2 -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Kho Dược / Tủ trực" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardWhCount" Text="6" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandCyan}"/>
                                    <TextBlock Text="Đã map 1:1" Foreground="{StaticResource SuccessGreen}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 3 -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Thuốc &amp; VTYT" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardDrugCount" Text="16" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                    <TextBlock Text="Tồn kho dương" Foreground="{StaticResource SuccessGreen}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 4 -->
                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="User HIS Khảo thí" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardUserCount" Text="16" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandNavy}"/>
                                    <TextBlock Text="Đủ phân bổ đợt thi" Foreground="{StaticResource SuccessGreen}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 5 -->
                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Ca bệnh nội trú" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardInpatientCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandCyan}"/>
                                    <TextBlock Text="Đang nằm viện" Foreground="{StaticResource SuccessGreen}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 6 -->
                            <Border Grid.Column="5" Style="{StaticResource CardBorder}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bệnh án ngoại trú" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardOutpatientCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                    <TextBlock Text="Đang điều trị" Foreground="{StaticResource SuccessGreen}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Connection Profile Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Kết nối SQL Server HIS (Read-only SELECT)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tên Profile" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="ProfileNameTextBox" Text="HIS_ThienHanh_Production"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Máy chủ (Server / Instance)" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="ServerTextBox" Text="192.168.1.10\THIENHANH"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Cơ sở dữ liệu (Database)" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="DatabaseTextBox" Text="eHospital_ThienHanh"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="WindowsAuthenticationCheckBox" Content="Sử dụng Windows Authentication" VerticalAlignment="Center" Click="AuthenticationChanged"/>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock x:Name="SqlUserLabel" Text="Tài khoản SQL (Username)" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="SqlUserTextBox" Text="sa"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock x:Name="SqlPasswordLabel" Text="Mật khẩu SQL (Bảo mật DPAPI)" Foreground="{StaticResource TextSecondary}"/>
                                        <PasswordBox x:Name="SqlPasswordBox"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock x:Name="ConnectionStatusText" Text="Chưa kết nối." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Kiểm tra kết nối (Test)" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click"/>
                                        <Button Content="Lưu Cấu Hình" Style="{StaticResource SecondaryButton}" Click="SaveSettings_Click"/>
                                        <Button Content="🔄 Đồng bộ Catalog HIS" Style="{StaticResource PrimaryButton}" Click="SynchronizeCatalogs_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Local Snapshot Status Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Trạng thái Bản ghi Snapshot CSDL Nội bộ (Local SQLite)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="CatalogsGrid" Height="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên danh mục" Binding="{Binding Catalog}" Width="2*"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Số lượng bản ghi" Binding="{Binding Count}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: TRA CỨU TỒN KHO -->
            <TabItem Header="5. Tra cứu tồn kho">
                <Grid Margin="6,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Bộ lọc Tra cứu Tồn kho Dược &amp; VTYT (Snapshot)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Khoa / Phòng" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="InventoryDepartmentComboBox" SelectionChanged="InventoryDepartmentChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="Kho Dược / Tủ trực" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="InventoryWarehouseComboBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="Nguồn cấp" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="InventorySourceComboBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0">
                                    <TextBlock Text="Tìm kiếm Tên / Mã Thuốc" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="InventorySearchTextBox" KeyDown="InventorySearch_KeyDown"/>
                                </StackPanel>
                                <Button Grid.Column="4" Content="🔍 Tra cứu" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="8,0,0,8" Click="SearchInventory_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <DataGrid x:Name="InventoryGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã thuốc/VTYT" Binding="{Binding DrugCode}" Width="120"/>
                                <DataGridTextColumn Header="Tên thuốc / Hàm lượng" Binding="{Binding DrugName}" Width="2.5*"/>
                                <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding Unit}" Width="85"/>
                                <DataGridTextColumn Header="Khoa / Phòng" Binding="{Binding DepartmentName}" Width="1.4*"/>
                                <DataGridTextColumn Header="Kho dược" Binding="{Binding WarehouseName}" Width="1.4*"/>
                                <DataGridTextColumn Header="Nguồn" Binding="{Binding FundingSource}" Width="75"/>
                                <DataGridTextColumn Header="Số lượng tồn" Binding="{Binding QuantityOnHand}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: LỊCH SỬ SINH ĐỀ -->
            <TabItem Header="6. Lịch sử Sinh đề">
                <Grid Margin="6,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Lịch sử các Đợt Thi Đã Sinh" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource BrandCyanSoft}" CornerRadius="10" Padding="8,2" Margin="10,0">
                                    <TextBlock Text="Truy vết đầy đủ" Foreground="{StaticResource BrandCyan}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="HistorySearchTextBox" Width="240" Margin="0,0,8,0" TextChanged="HistorySearchChanged"/>
                                <Button Content="Làm mới" Style="{StaticResource SecondaryButton}" Click="ReloadHistory_Click"/>
                                <Button Content="📂 Mở tệp ZIP" Style="{StaticResource PrimaryButton}" Click="OpenHistoryFile_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <DataGrid x:Name="HistoryGrid" MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên đợt thi" Binding="{Binding Batch}" Width="1.5*"/>
                                <DataGridTextColumn Header="Ngày thi" Binding="{Binding FormattedExamDate}" Width="105"/>
                                <DataGridTextColumn Header="Tệp tin ZIP" Binding="{Binding FileName}" Width="1.8*"/>
                                <DataGridTextColumn Header="Thời điểm tạo" Binding="{Binding FormattedCreatedAt}" Width="140"/>
                                <DataGridTextColumn Header="Đường dẫn tệp tin" Binding="{Binding FilePath}" Width="2.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 7: CHẤM THI ĐỐI SOÁT (ASSISTED GRADING) -->
            <TabItem Header="7. Chấm thi đối soát">
                <Grid Margin="6,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Chấm thi Đối soát (Assisted Grading)" FontSize="16" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrandTealSoft}" CornerRadius="10" Padding="8,2" Margin="10,0">
                                    <TextBlock x:Name="GradingSummaryBadge" Text="0 bài nộp" Foreground="{StaticResource BrandTealDark}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="Đối soát bài làm so với đáp án và vết HIS - Nhập điểm &amp; nhận xét cho từng câu." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📂 Chọn thư mục bài nộp..." Style="{StaticResource SecondaryButton}" Click="BrowseSubmissionsDirectory_Click"/>
                                <Button Content="🔄 Làm mới bài nộp" Style="{StaticResource SecondaryButton}" Click="ReloadSubmissions_Click"/>
                                <Button Content="🔍 Truy vấn vết HIS" Style="{StaticResource AccentButton}" Click="QueryHisAuditTrail_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main 2-column layout -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="300"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="500"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column Left: Submissions List -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="DANH SÁCH BÀI THI ĐÃ NỘP" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandNavy}" Margin="0,0,0,8"/>
                                
                                <DataGrid x:Name="SubmissionsGrid" SelectionChanged="SubmissionsGrid_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SBD" Binding="{Binding CandidateId}" Width="65"/>
                                        <DataGridTextColumn Header="Thí sinh" Binding="{Binding CandidateName}" Width="1.2*"/>
                                        <DataGridTextColumn Header="Khoa" Binding="{Binding DepartmentName}" Width="*"/>
                                        <DataGridTextColumn Header="Điểm" Binding="{Binding DisplayScore}" Width="60"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="85"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- GridSplitter -->
                        <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Center"/>

                        <!-- Column Right: Assisted Grading Worksheet -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                            <Grid>
                                <!-- Placeholder when nothing selected -->
                                <TextBlock x:Name="NoSubmissionSelectedPlaceholder"
                                           Text="Vui lòng chọn một thí sinh từ danh sách bên trái để thực hiện chấm thi đối soát."
                                           FontSize="14"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Candidate Grading Panel -->
                                <Grid x:Name="CandidateGradingPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Candidate Header Summary Card -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="GradingCandidateNameTextBlock" Text="Nguyễn Văn A" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandNavy}"/>
                                                    <TextBlock Text=" - " Foreground="{StaticResource TextSecondary}" FontSize="16"/>
                                                    <TextBlock x:Name="GradingCandidateIdTextBlock" Text="SBD: 101" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}"/>
                                                    <TextBlock Text=" | Khoa: " Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="10,3,0,0"/>
                                                    <TextBlock x:Name="GradingDepartmentTextBlock" Text="Ngoại" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="User HIS: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                                    <TextBlock x:Name="GradingHisUserTextBlock" Text="USER_THI" FontWeight="SemiBold" Foreground="{StaticResource BrandCyan}" FontSize="12"/>
                                                    <TextBlock Text=" | Nộp lúc: " Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="10,0,0,0"/>
                                                    <TextBlock x:Name="GradingSubmittedAtTextBlock" Text="08:35:12" FontSize="12"/>
                                                    <TextBlock Text=" | Bù giờ: " Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="10,0,0,0"/>
                                                    <TextBlock x:Name="GradingExtraTimeTextBlock" Text="+5 phút" FontWeight="Bold" Foreground="{StaticResource WarningAmber}" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Real-time Total Score Box -->
                                            <Border Grid.Column="1" Background="{StaticResource BrandTealSoft}" BorderBrush="{StaticResource BrandTeal}" BorderThickness="1.5" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="TỔNG ĐIỂM CHẤM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}" HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="GradingTotalScoreTextBlock" Text="0.0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}"/>
                                                        <TextBlock Text=" / 10.0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Questions Scoring List -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                        <ItemsControl x:Name="GradingItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12" Background="White">
                                                        <StackPanel>
                                                            <!-- Row 1: Question Header & Max Score -->
                                                            <Grid Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding TitleHeader}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandNavy}"/>
                                                                <TextBlock Text="{Binding MaxScoreText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource BrandCyan}" FontSize="12"/>
                                                            </Grid>

                                                            <!-- Row 2: Question Instruction -->
                                                            <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="13" LineHeight="20" Margin="0,0,0,8"/>

                                                            <!-- Row 3: Expected Answer vs Candidate's Actual Performance -->
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left: Expected Answer -->
                                                                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                                                    <StackPanel>
                                                                        <TextBlock Text="🎯 ĐÁP ÁN CHUẨN / YÊU CẦU THỰC HIỆN:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrandTealDark}" Margin="0,0,0,4"/>
                                                                        <TextBlock Text="{Binding ExpectedAnswer}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="#1E293B"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Right: Actual Candidate Result -->
                                                                <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                                                    <StackPanel>
                                                                        <TextBlock Text="📝 KẾT QUẢ THÍ SINH ĐÃ THỰC HIỆN:" FontWeight="Bold" FontSize="11" Foreground="#92400E" Margin="0,0,0,4"/>
                                                                        <TextBlock Text="{Binding CandidateActualDisplay}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="#78350F"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Row 4: Scoring Input & Examiner Note -->
                                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="130"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="Điểm chấm:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrandNavy}"/>
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding ScoreAwardedText, UpdateSourceTrigger=PropertyChanged}"
                                                                             Height="36"
                                                                             FontSize="15"
                                                                             FontWeight="Bold"
                                                                             HorizontalContentAlignment="Center"
                                                                             Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="2" Text="Chú thích / Nhận xét:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                                                                    <TextBox Grid.Column="3"
                                                                             Text="{Binding ExaminerRemark, UpdateSourceTrigger=PropertyChanged}"
                                                                             Height="36"
                                                                             FontSize="13"
                                                                             Padding="8,5"
                                                                             Margin="0"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Bottom Examiner Signature & Actions -->
                                    <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Cán bộ chấm thi:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBox x:Name="ExaminerNameTextBox" Text="Giám khảo Hội đồng thi" Height="34" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="Nhận xét tổng thể bài thi:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBox x:Name="GeneralRemarkTextBox" Text="Bài làm đạt yêu cầu" Height="34" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Button Content="💾 LƯU KẾT QUẢ CHẤM" Style="{StaticResource PrimaryButton}" Padding="16,8" Height="38" Click="SaveGrading_Click"/>
                                                <Button Content="🖨️ XUẤT BIÊN BẢN CHẤM (WORD)" Style="{StaticResource AccentButton}" Padding="16,8" Height="38" Margin="8,0,0,0" Click="ExportGradingWord_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
