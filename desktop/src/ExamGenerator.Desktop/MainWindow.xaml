<Window x:Class="ExamGenerator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Khảo Thí HIS - Bệnh Viện Đa Khoa Thiện Hạnh" 
        Height="860" Width="1340" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}" Loaded="Window_Loaded">
    <DockPanel>
        <!-- Header: Thiện Hạnh Branding & Live Status -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandNavy}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource BrandTeal}" Margin="0,0,16,0">
                        <TextBlock Text="TH" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BỆNH VIỆN ĐA KHOA THIỆN HẠNH" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Hội Đồng Thi Tuyển Dụng · Exam Operations Desktop (HIS eHospital)" Foreground="{StaticResource BrandTealSoft}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <Border Background="{StaticResource BrandSlate}" CornerRadius="12" Padding="10,4" Margin="6,0">
                            <TextBlock x:Name="HeaderStatusText" Text="Hệ thống sẵn sàng" Foreground="{StaticResource BrandTealSoft}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="12" Padding="10,4">
                            <TextBlock Text=".NET 8 LTS · WPF" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeaderSubText" Text="Cơ sở dữ liệu: exam-generator.sqlite" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Text="Sẵn sàng." Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBlock Text="Phiên bản 2026.09 · Hội đồng tuyển dụng BVĐK Thiện Hạnh" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl x:Name="MainTabs" Margin="20,14,20,16">

            <!-- TAB 1: THỰC THI TẠO ĐỀ -->
            <TabItem Header="1. Thực thi tạo đề">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,12">
                        <!-- Card 1: Batch & Candidate Input -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Cấu hình Đợt thi &amp; Thêm Thí sinh" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Thiết lập thông tin khảo thí, chọn khoa và mẫu đề thi tương ứng." HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tên đợt thi" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="BatchNameTextBox" Text="TuyenDung_2026"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Ngày thi" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <DatePicker x:Name="ExamDatePicker" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0">
                                        <TextBlock Text="Họ tên thí sinh" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="CandidateNameTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0">
                                        <TextBlock Text="Số báo danh (SBD)" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="CandidateIdTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                        <TextBlock Text="Khoa / Phòng ứng tuyển" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="ExamDepartmentComboBox" SelectionChanged="ExamDepartmentChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Mẫu đề thi theo Khoa" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="ExamTemplateComboBox" SelectionChanged="ExamTemplateChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Thời gian làm bài (phút)" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="ExamDurationTextBox" Text="30" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Phân bổ User HIS" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                        <Border Background="{StaticResource BrandTealSoft}" CornerRadius="6" Padding="10,7" Height="34" Margin="0,4,0,8">
                                            <TextBlock x:Name="UserAllocationSummaryText" Text="Tự động cấp User riêng không trùng" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Score Preview Box -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource BrandCyanSoft}" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="MẪU ĐỀ" Foreground="{StaticResource BrandCyan}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock x:Name="ScoreSummaryText" Text="Chọn khoa và mẫu đề để xem chi tiết thang điểm." FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button Content="+ Thêm vào danh sách" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="AddCandidate_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Candidates List Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Danh sách Thí sinh chờ sinh đề" FontSize="16" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource BrandCyanSoft}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="CandidatesCountBadge" Text="0 thí sinh" Foreground="{StaticResource BrandCyan}" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Click="SelectAllCandidates_Click"/>
                                        <Button Content="Bỏ chọn tất cả" Style="{StaticResource SecondaryButton}" Click="ClearCandidateSelection_Click"/>
                                        <Button Content="Xóa đã chọn" Style="{StaticResource SecondaryButton}" Click="RemoveSelectedCandidates_Click"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="CandidatesGrid" Height="240">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding Name}" Width="1.8*"/>
                                        <DataGridTextColumn Header="Số báo danh" Binding="{Binding Id}" Width="1*"/>
                                        <DataGridTextColumn Header="Khoa / Phòng" Binding="{Binding Department}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Mẫu đề thi" Binding="{Binding Template}" Width="2*"/>
                                        <DataGridTextColumn Header="Thời gian" Binding="{Binding DurationText}" Width="80"/>
                                        <DataGridTextColumn Header="Quy tắc cấp User HIS" Binding="{Binding UserStatus}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="GenerationStatusText" Text="Sẵn sàng chạy Preflight và sinh đề." Foreground="{StaticResource TextSecondary}" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Sinh phần đã chọn (.zip)" Style="{StaticResource SecondaryButton}" Click="GenerateSelected_Click"/>
                                        <Button Content="⚡ Sinh Cả Đợt Thi (.zip)" Style="{StaticResource PrimaryButton}" Padding="20,10" FontSize="14" Click="GenerateAll_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: QUẢN LÝ MẪU ĐỀ -->
            <TabItem Header="2. Quản lý Mẫu đề">
                <Grid Margin="6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Templates List -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Danh sách Mẫu Đề Thi" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Tạo mẫu mới" Style="{StaticResource PrimaryButton}" Click="NewTemplate_Click"/>
                                    <Button Content="Clone" Style="{StaticResource SecondaryButton}" Click="CloneTemplate_Click"/>
                                    <Button Content="Xóa" Style="{StaticResource DangerButton}" Click="DeleteTemplate_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="TemplatesGrid" SelectionChanged="TemplateSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên mẫu đề" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Khoa áp dụng" Binding="{Binding Department}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Số câu" Binding="{Binding QuestionCount}" Width="60"/>
                                    <DataGridTextColumn Header="Tổng điểm" Binding="{Binding TotalScore}" Width="80"/>
                                    <DataGridTextColumn Header="Hình thức nhận ca" Binding="{Binding Status}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Right: Selected Template Questions -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Chi tiết Câu hỏi &amp; Thang điểm" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TemplateDetailTitle" Text="Chọn một mẫu đề để xem nội dung" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}" Margin="0,0,0,8"/>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <TextBlock x:Name="TemplateActionsText" Text="Danh sách câu hỏi..." TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: PHÂN QUYỀN DỊCH VỤ & KHO -->
            <TabItem Header="3. Phân quyền Dịch vụ &amp; Kho">
                <Grid Margin="6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Departments Master -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Khoa / Phòng Khảo thí" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox DockPanel.Dock="Top" x:Name="MappingSearchTextBox" TextChanged="MappingSearchChanged" Margin="0,0,0,8"/>
                            <ListBox x:Name="MappingDepartmentList" SelectionChanged="MappingDepartmentChanged" DisplayMemberPath="Name" BorderBrush="{StaticResource BorderSubtle}"/>
                        </DockPanel>
                    </Border>

                    <!-- Right: Mapping Detail -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="MappingTitleText" Text="Cấu hình Kho thi &amp; Nhóm Dịch vụ" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandNavy}"/>
                                <TextBlock Text="Quy tắc chuẩn: Mỗi khoa chỉ được gắn đúng một Kho thi duy nhất để đảm bảo tính nhất quán của đề thi." Foreground="{StaticResource TextSecondary}" Margin="0,2,0,16"/>

                                <TextBlock Text="Kho Dược / Tủ trực thi duy nhất (Bắt buộc)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="MappingWarehouseComboBox" IsEditable="True"/>

                                <TextBlock Text="Nhóm Dịch vụ Kỹ thuật / CLS được phép chỉ định" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServiceSearchTextBox" TextChanged="ServiceSearchChanged" Height="32"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="SelectAllServices_Click"/>
                                        <Button Content="Bỏ chọn tất cả" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="ClearAllServices_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ServiceGroupsList" Height="240" BorderBrush="{StaticResource BorderSubtle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock x:Name="MappingStatusText" Text="Sẵn sàng lưu cấu hình." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Sao chép từ khoa khác" Style="{StaticResource SecondaryButton}" Click="CopyMapping_Click"/>
                                        <Button Content="Lưu Cấu Hình Khoa Này" Style="{StaticResource PrimaryButton}" Click="SaveMapping_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: CÀI ĐẶT & DANH MỤC HIS -->
            <TabItem Header="4. Cài đặt &amp; Danh mục HIS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,12">
                        <!-- Dashboard 6 Cards -->
                        <TextBlock Text="Tổng quan Danh mục Khảo thí (Local Snapshot)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Card 1 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Khoa / Phòng" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardDeptCount" Text="6" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                    <TextBlock Text="Snapshot đầy đủ" Foreground="{StaticResource SuccessGreen}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 2 -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Kho Dược / Tủ trực" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardWhCount" Text="6" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandCyan}"/>
                                    <TextBlock Text="Đã map 1:1" Foreground="{StaticResource SuccessGreen}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 3 -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Thuốc &amp; VTYT có tồn" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardDrugCount" Text="16" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                    <TextBlock Text="Tồn kho dương" Foreground="{StaticResource SuccessGreen}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <!-- Card 4 -->
                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="User HIS Khảo thí" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="CardUserCount" Text="16" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandNavy}"/>
                                    <TextBlock Text="Đủ phân bổ đợt thi" Foreground="{StaticResource SuccessGreen}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Connection Profile Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Kết nối SQL Server HIS (Read-only SELECT)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tên Profile" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="ProfileNameTextBox" Text="HIS_ThienHanh_Production"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Máy chủ (Server / Instance)" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="ServerTextBox" Text="192.168.1.10\THIENHANH"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Cơ sở dữ liệu (Database)" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="DatabaseTextBox" Text="eHospital_ThienHanh"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="WindowsAuthenticationCheckBox" Content="Sử dụng Windows Authentication" VerticalAlignment="Center" Click="AuthenticationChanged"/>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock x:Name="SqlUserLabel" Text="Tài khoản SQL (Username)" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="SqlUserTextBox" Text="sa"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock x:Name="SqlPasswordLabel" Text="Mật khẩu SQL (Bảo mật DPAPI)" Foreground="{StaticResource TextSecondary}"/>
                                        <PasswordBox x:Name="SqlPasswordBox"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock x:Name="ConnectionStatusText" Text="Chưa kết nối." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Kiểm tra kết nối (Test)" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click"/>
                                        <Button Content="Lưu Cấu Hình" Style="{StaticResource SecondaryButton}" Click="SaveSettings_Click"/>
                                        <Button Content="🔄 Đồng bộ Catalog HIS" Style="{StaticResource PrimaryButton}" Click="SynchronizeCatalogs_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Local Snapshot Status Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Trạng thái Bản ghi Snapshot CSDL Nội bộ (Local SQLite)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="CatalogsGrid" Height="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên danh mục" Binding="{Binding Catalog}" Width="2*"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Số lượng bản ghi" Binding="{Binding Count}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: TRA CỨU TỒN KHO -->
            <TabItem Header="5. Tra cứu tồn kho">
                <Grid Margin="6,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Bộ lọc Tra cứu Tồn kho Dược &amp; VTYT (Snapshot)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Khoa / Phòng" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="InventoryDepartmentComboBox" SelectionChanged="InventoryDepartmentChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="Kho Dược / Tủ trực" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="InventoryWarehouseComboBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="Nguồn cấp" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="InventorySourceComboBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0">
                                    <TextBlock Text="Tìm kiếm Tên / Mã Thuốc" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="InventorySearchTextBox" KeyDown="InventorySearch_KeyDown"/>
                                </StackPanel>
                                <Button Grid.Column="4" Content="🔍 Tra cứu" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="8,0,0,8" Click="SearchInventory_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <DataGrid x:Name="InventoryGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã thuốc/VTYT" Binding="{Binding DrugCode}" Width="120"/>
                                <DataGridTextColumn Header="Tên thuốc / Hàm lượng" Binding="{Binding DrugName}" Width="2.5*"/>
                                <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding Unit}" Width="85"/>
                                <DataGridTextColumn Header="Khoa / Phòng" Binding="{Binding DepartmentName}" Width="1.4*"/>
                                <DataGridTextColumn Header="Kho dược" Binding="{Binding WarehouseName}" Width="1.4*"/>
                                <DataGridTextColumn Header="Nguồn" Binding="{Binding FundingSource}" Width="75"/>
                                <DataGridTextColumn Header="Số lượng tồn" Binding="{Binding QuantityOnHand}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: LỊCH SỬ SINH ĐỀ -->
            <TabItem Header="6. Lịch sử Sinh đề">
                <Grid Margin="6,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Lịch sử các Đợt Thi Đã Sinh" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource BrandCyanSoft}" CornerRadius="10" Padding="8,2" Margin="10,0">
                                    <TextBlock Text="Truy vết đầy đủ" Foreground="{StaticResource BrandCyan}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="HistorySearchTextBox" Width="240" Margin="0,0,8,0" TextChanged="HistorySearchChanged"/>
                                <Button Content="Làm mới" Style="{StaticResource SecondaryButton}" Click="ReloadHistory_Click"/>
                                <Button Content="📂 Mở tệp ZIP" Style="{StaticResource PrimaryButton}" Click="OpenHistoryFile_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <DataGrid x:Name="HistoryGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên đợt thi" Binding="{Binding Batch}" Width="1.5*"/>
                                <DataGridTextColumn Header="Ngày thi" Binding="{Binding ExamDate}" Width="110"/>
                                <DataGridTextColumn Header="Đường dẫn tệp tin ZIP" Binding="{Binding FilePath}" Width="3*"/>
                                <DataGridTextColumn Header="Thời điểm sinh" Binding="{Binding CreatedAt}" Width="1.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
