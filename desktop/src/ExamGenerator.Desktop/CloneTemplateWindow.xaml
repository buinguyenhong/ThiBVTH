<Window x:Class="ExamGenerator.Desktop.CloneTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhân bản (Clone) Mẫu đề thi"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Nhân bản Mẫu Đề Thi" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandNavy}"/>
                <TextBlock x:Name="SourceInfoText" Text="Đề gốc: ..." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form fields -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tên mẫu đề mới (*):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NewNameTextBox" Margin="0,0,0,12" Padding="8,6"/>

                <TextBlock Text="Khoa / Phòng áp dụng (*):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="DepartmentComboBox" Margin="0,0,0,12" Padding="8,6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Vị trí chuyên môn:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PositionComboBox" IsEditable="True" Margin="0,0,0,0" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hình thức nhận ca:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ReceptionModeComboBox" Margin="0,0,0,0" Padding="8,6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True" Padding="16,8"/>
            <Button Content="✓ Xác nhận Nhân bản" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsDefault="True" Padding="18,8" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
