<Window x:Class="ExamGenerator.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bệnh Viện Đa Khoa Thiện Hạnh - Hệ Thống Thi Tác Nghiệp HIS"
        Height="780"
        Width="1100"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>
        <!-- ========================================== -->
        <!-- 1. LOGIN / EXAM SELECTION PANEL            -->
        <!-- ========================================== -->
        <Grid x:Name="LoginPanel" Visibility="Visible">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    MaxWidth="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="36,30">
                <StackPanel>
                    <!-- Hospital Logo / Header -->
                    <TextBlock Text="BỆNH VIỆN ĐA KHOA THIỆN HẠNH"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandTealDark}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="HỆ THỐNG THI TÁC NGHIỆP TRÊN PHẦN MỀM HIS"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandNavy}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,20"/>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,20"/>

                    <TextBlock Text="CHỌN HOẶC TẢI ĐỀ THI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,8"/>

                    <!-- Candidate Selector -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CandidatePackageComboBox"
                                  Grid.Column="0"
                                  Height="40"
                                  FontSize="14"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="CandidatePackageComboBox_SelectionChanged"/>
                        <Button Grid.Column="1"
                                Content="📂 Mở file đề (.exam_pkg)..."
                                Style="{StaticResource SecondaryButton}"
                                Height="40"
                                Margin="8,0,0,8"
                                Padding="12,0"
                                Click="BrowseExamPackage_Click"/>
                    </Grid>

                    <!-- Exam Details Card -->
                    <Border x:Name="PackageInfoBorder"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,4,0,20"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Số báo danh (SBD):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="InfoCandidateIdTextBlock" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock Text="Họ và tên thí sinh:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="InfoCandidateNameTextBlock" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandNavy}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Khoa phòng:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="InfoDepartmentTextBlock" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock Text="Thời gian làm bài:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="InfoDurationTextBlock" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandCyan}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="Tài khoản HIS được cấp tác nghiệp:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="InfoHisUserTextBlock" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WarningAmber}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Instructions -->
                    <TextBlock Text="* Lưu ý: Khi bấm 'Bắt đầu làm bài', đồng hồ đếm ngược sẽ bắt đầu chạy theo thời gian quy định của đề bài. Thí sinh thao tác trên HIS và điền câu trả lời vào phần mềm này."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <!-- Start Button -->
                    <Button x:Name="StartExamButton"
                            Content="🚀 BẮT ĐẦU LÀM BÀI THI"
                            Style="{StaticResource SubmitButton}"
                            Height="48"
                            FontSize="16"
                            IsEnabled="False"
                            Click="StartExamButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ========================================== -->
        <!-- 2. EXAM WORKSTATION PANEL                  -->
        <!-- ========================================== -->
        <Grid x:Name="WorkstationPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrandNavy}"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Candidate Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BrandTeal}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="HeaderCandidateIdTextBlock"
                                           Text="SBD: 101"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           FontSize="13"/>
                            </Border>
                            <TextBlock x:Name="HeaderCandidateNameTextBlock"
                                       Text="Họ và tên thí sinh"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontSize="16"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="HeaderDepartmentTextBlock"
                                       Text="Khoa Khám Bệnh"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            <TextBlock Text=" | " Foreground="#475569" FontSize="12"/>
                            <TextBlock x:Name="HeaderHisUserTextBlock"
                                       Text="User HIS: USER_THI (PW: 123)"
                                       Foreground="#38BDF8"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Digital Countdown Timer -->
                    <Border Grid.Column="1"
                            x:Name="TimerContainerBorder"
                            Background="#0B132B"
                            BorderBrush="#1E293B"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="20,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="THỜI GIAN CÒN LẠI"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CountdownTimerTextBlock"
                                           Text="30:00"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="#34D399"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="ExtraTimeBadge"
                                    Background="{StaticResource WarningAmber}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ExtraTimeBadgeText"
                                           Text="+5 phút"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right: Actions -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Add Extra Time button -->
                        <Button x:Name="AddExtraTimeButton"
                                Content="⏰ Bù giờ sự cố"
                                Style="{StaticResource WarningButton}"
                                Height="42"
                                Padding="14,0"
                                Margin="0,0,10,0"
                                ToolTip="Giám thị nhập mật khẩu để cộng thêm giờ khi gặp sự cố"
                                Click="AddExtraTimeButton_Click"/>

                        <!-- 1-Click Submit button -->
                        <Button x:Name="SubmitExamButton"
                                Content="📤 NỘP BÀI &amp; GỬI KẾT QUẢ"
                                Style="{StaticResource SubmitButton}"
                                Height="42"
                                Padding="18,0"
                                Click="SubmitExamButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Locked / Time-out Alert Banner -->
            <Border Grid.Row="1"
                    x:Name="TimeoutWarningBanner"
                    Background="{StaticResource DangerRed}"
                    Padding="16,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠️ ĐÃ HẾT THỜI GIAN LÀM BÀI! Bài làm đã được khóa. Vui lòng bấm 'NỘP BÀI &amp; GỬI KẾT QUẢ' hoặc liên hệ Giám thị bấm 'Bù giờ sự cố' để tiếp tục."
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Bù giờ mở khóa bài"
                            Style="{StaticResource SecondaryButton}"
                            Height="32"
                            Padding="12,0"
                            Click="AddExtraTimeButton_Click"/>
                </Grid>
            </Border>

            <!-- Questions Scroll Area -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16">
                <StackPanel MaxWidth="960" HorizontalAlignment="Center">
                    <TextBlock Text="NỘI DUNG ĐỀ THI TÁC NGHIỆP"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandNavy}"
                               Margin="0,0,0,12"/>

                    <!-- Questions ItemsControl -->
                    <ItemsControl x:Name="QuestionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Question Title & Max Score -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding HeaderTitle}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrandTealDark}"/>
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource BrandCyanSoft}"
                                                    CornerRadius="4"
                                                    Padding="8,3">
                                                <TextBlock Text="{Binding ScoreText}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrandCyan}"
                                                           FontSize="12"/>
                                            </Border>
                                        </Grid>

                                        <!-- Instruction -->
                                        <TextBlock Text="{Binding Instruction}"
                                                   FontSize="13.5"
                                                   LineHeight="22"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <!-- Detail Text (Drugs, Patients, Dates, etc.) -->
                                        <Border Background="#F8FAFC"
                                                BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding DetailVisibility}">
                                            <TextBlock Text="{Binding DetailText}"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="12.5"
                                                       LineHeight="20"
                                                       Foreground="#334155"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Input / Answer Area -->
                                        <!-- Case A: Fill-in Question -->
                                        <StackPanel Visibility="{Binding FillInVisibility}">
                                            <TextBlock Text="{Binding FillInPrompt}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrandNavy}"
                                                       FontSize="13"
                                                       Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CandidateAnswer, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding DataContext.IsExamActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Height="42"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Padding="10,6"
                                                     BorderBrush="{StaticResource BrandCyan}"/>
                                            <TextBlock Text="💡 Kết quả được lưu tự động liên tục."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="2,-4,0,0"/>
                                        </StackPanel>

                                        <!-- Case B: Practical HIS Action -->
                                        <Border Visibility="{Binding PracticalHisVisibility}"
                                                Background="{StaticResource SuccessSoft}"
                                                BorderBrush="#A7F3D0"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💻" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Thực hiện thao tác trực tiếp trên phần mềm HIS bằng tài khoản được cấp. Hệ thống sẽ ghi nhận lịch sử tác nghiệp đối soát."
                                                           FontSize="12.5"
                                                           Foreground="#065F46"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>


        <!-- ========================================== -->
        <!-- 3. SUBMITTED / SUCCESS PANEL               -->
        <!-- ========================================== -->
        <Grid x:Name="SubmittedPanel" Visibility="Collapsed">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    MaxWidth="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="40,36">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="BÀI THI ĐÃ ĐƯỢC NỘP THÀNH CÔNG!"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessGreen}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Kết quả thi và vết tác nghiệp HIS đã được đóng gói và gửi về Hội đồng chấm thi."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,24"/>

                    <!-- Summary Table -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Thí sinh:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SummaryCandidateTextBlock" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Thời gian bắt đầu:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SummaryStartedAtTextBlock" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Thời gian nộp bài:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SummarySubmittedAtTextBlock" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Thời gian bù giờ:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SummaryExtraMinutesTextBlock" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource WarningAmber}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Mã gói bài nộp:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SummarySubmissionIdTextBlock" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource BrandNavy}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Đóng ứng dụng"
                            Style="{StaticResource SecondaryButton}"
                            Height="42"
                            Width="160"
                            HorizontalAlignment="Center"
                            Click="ExitApplication_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
